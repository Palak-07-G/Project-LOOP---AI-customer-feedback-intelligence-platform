# GEMINI_API_KEY: Optional/Default AI engine for classification & RAG
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ANTHROPIC_API_KEY: Optional Anthropic Claude engine key (claude-sonnet-4-6)
ANTHROPIC_API_KEY="MY_ANTHROPIC_API_KEY"

# DATABASE_URL: PostgreSQL or LibSQL database connection URL
DATABASE_URL="file:./data/loop.db"

# AUTH_SECRET: Session secret for signing JWTs
AUTH_SECRET="loop-secret-key-super-secure-production-ready"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
